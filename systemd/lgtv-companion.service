[Unit]
Description=LGTV Companion Linux system service
Wants=network-online.target
After=network-online.target
# Deliberately independent of graphical and user sessions.
# Power-off hooks will not be enabled until shutdown/reboot discrimination is proven.

[Service]
Type=simple
ExecStart=/usr/bin/lgtv-companion --config /etc/lgtv-companion/config.toml
Restart=on-failure
RestartSec=5
User=root
Group=root
RuntimeDirectory=lgtv-companion
StateDirectory=lgtv-companion
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lgtv-companion /run/lgtv-companion
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
